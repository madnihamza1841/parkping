SECRET_KEY=django-insecure-replace-with-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL for production; SQLite used in local.py by default)
DB_NAME=parkping
DB_USER=parkping_user
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Agora (VoIP)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Firebase Admin SDK credentials JSON path
FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json

# ParkPing deep link config
PARKPING_WEB_BASE_URL=https://parkping.app
